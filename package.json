{
  "name": "youtube-music-desktop-app",
  "productName": "YTM Desktop",
  "version": "3.3.0",
  "description": "A modern, high-performance YouTube Music desktop client",
  "main": ".vite/main/index.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish:dry": "electron-forge make",
    "publish:fromdry": "electron-forge release --from-make",
    "publish": "electron-forge release",
    "lint": "eslint --ext .ts,.tsx,.vue .",
    "lint:fix": "eslint --ext .ts,.tsx,.vue . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "node tests/maintenance.cjs && node tests/discord.cjs && node tests/dependencies.cjs",
    "test:built": "node tests/bundles.cjs && node tests/player-controls.cjs --built && node tests/settings-built.cjs",
    "test:ui": "node tests/playback-coachmark.cjs && node tests/player-controls.cjs",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,vue,js,css}\" \"config/**/*.ts\" \"*.{ts,json}\"",
    "prettier:fix": "prettier --write \"src/**/*.{ts,tsx,vue,js,css}\" \"config/**/*.ts\" \"*.{ts,json}\"",
    "check": "yarn typecheck && yarn lint && yarn prettier",
    "release:check": "yarn check && yarn package",
    "postinstall": "husky"
  },
  "keywords": [
    "youtube-music",
    "desktop",
    "electron",
    "music",
    "stream-deck"
  ],
  "author": {
    "name": "AaranCloud",
    "email": "10285730+Lostepic@users.noreply.github.com"
  },
  "repository": "github:Lostepic/ytmdesktop",
  "bugs": "https://github.com/Lostepic/ytmdesktop/issues",
  "homepage": "https://github.com/Lostepic/ytmdesktop#readme",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "45.3.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/error": "^4.2.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "conf": "^16.0.0",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "fastify": "5.12.8",
    "material-symbols": "^0.49.0",
    "socket.io": "^4.8.4",
    "typebox": "^1.4.7",
    "vue": "^3.5.45"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.22.0"
  },
  "resolutions": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  }
}
